# 이 파일은 "어떤 설정이 필요한지" 이름만 적은 견본입니다. 실제 값은 넣지 마세요.
# 실제 값은 같은 폴더의 .env.local 파일에 직접 입력합니다 (.env.local은 GitHub에 올라가지 않습니다).

# Supabase 프로젝트 주소 (공개되어도 안전)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 공개용 키 (Publishable key 또는 anon key — 공개되어도 안전, 데이터 접근은 보안 규칙이 막음)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase 서버 전용 비밀 키 (Secret key 또는 service_role key — 절대 공개 금지, 브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API 키 (서버 전용 비밀 키 — 절대 공개 금지, 브라우저에 노출 금지)
OPENAI_API_KEY=

# 접속 코드 (선택). 값을 넣으면 화면에서 이 코드를 입력해야 채팅을 시작할 수 있다.
# 비워두면(로컬 개발 기본값) 게이트가 꺼진 채로 동작한다. 다른 사람과 공유하기 전에 값을 넣을 것.
ACCESS_CODE=

# 이론 기반 "행동 제안받기 / 내 고민 더 알아보기" 선택 대화 (기본 꺼짐).
# "true"로 정확히 설정했을 때만 켜진다. 2026-10-07 새 구조 개편 후에도 owner 확인 전까지는 켜지 말 것.
# THEORY_OFFER_ENABLED=
# 칩을 안 누르고 말을 이어가면 탐색으로 넘어갈지(기본 켜짐, "false"로 두면 평소 대화로 계속).
# THEORY_IMPLICIT_EXPLORE=true
# 이론 고르기에 쓰는 모델(없으면 CHAT_MODEL). 세션당 한 번 호출된다.
# THEORY_SELECT_MODEL=
# 이론 고르기 호출의 추론 수준(low/medium/high, 기본 low). "default"면 지정하지 않음.
# THEORY_SELECT_REASONING=low

# 홈 "오늘의 실천"에서 이론 기반 실천이 뽑힐 가중치(1~5, 기본 2 = 약 39%→56%). 1이면 가중치 없음.
# HOME_THEORY_PRACTICE_WEIGHT=2

# 채팅 속도 시험용 스위치(2026-10-16). 모두 비워 두면 기본 동작 — 값을 바꾸기 전에 반드시 `npm run safety:eval`로 판정 품질을 확인할 것.
# SAFETY_CLASSIFIER_REASONING=   # 안전 분류기 추론 수준(low/medium/high). 시험 결과 속도 차이가 없어 기본은 지정 안 함. "minimal"은 이 모델에서 지원되지 않음.
# SAFETY_CLASSIFIER_EXPLAIN=1    # 1이면 분류기가 판정 뒤에 "로그 전용 설명 문장"을 다시 쓴다(기본은 뺌 — 더 빠름).
# CHAT_REASONING=                # 답변 생성 추론 수준. low는 약 14% 빠르지만 답변이 짧아져 기본은 지정 안 함.


# 발화 해석(쏘웰라가 대화에서 마음·행동 경향을 파악해 장부에 쌓는 기능, 2026-10-18). 기본은 전체 켜짐 — 아래는 모두 선택 사항이다.
# SW_INTERP_ENABLED=0            # 0이면 끔(킬 스위치)
# SW_INTERP_ALLOWLIST=           # 비우면 전체. 일부에게만 켜려면 쉼표로 구분한 사용자 id 또는 이메일. "*"는 전체
# SW_INTERP_ROUTES=              # 분석할 대화 경로(기본 wellness,life_decision,clinical_distress)
# SW_STORE_EVIDENCE=0            # 0이면 사용자 말 조각을 저장하지 않음
# SW_CLASSIFIER_MODEL=           # 분류기 모델(기본은 THEORY_SELECT_MODEL → CHAT_MODEL → gpt-5.6-luna)
# SW_CLASSIFIER_REASONING=       # 기본 low
# SW_SCREENING_ENABLED=1       # 안전 스크리닝(죽음 이야기·학대 단서 질문, 중단 안내) 켜기 — 기본 꺼짐, 고정 문구 상담사 검토 후
# SW_SCREENING_ALLOWLIST=      # 쉼표로 구분한 사용자 id 또는 이메일(있으면 그 사용자만)
