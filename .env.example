# 이 파일은 "어떤 설정이 필요한지" 이름만 적은 견본입니다. 실제 값은 넣지 마세요.
# 실제 값은 같은 폴더의 .env.local 파일에 직접 입력합니다 (.env.local은 GitHub에 올라가지 않습니다).

# Supabase 프로젝트 주소 (공개되어도 안전)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase 공개용 키 (Publishable key 또는 anon key — 공개되어도 안전, 데이터 접근은 보안 규칙이 막음)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase 서버 전용 비밀 키 (Secret key 또는 service_role key — 절대 공개 금지, 브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API 키 (서버 전용 비밀 키 — 절대 공개 금지, 브라우저에 노출 금지)
OPENAI_API_KEY=

# 접속 코드 (선택). 값을 넣으면 화면에서 이 코드를 입력해야 채팅을 시작할 수 있다.
# 비워두면(로컬 개발 기본값) 게이트가 꺼진 채로 동작한다. 다른 사람과 공유하기 전에 값을 넣을 것.
ACCESS_CODE=

# 이론 기반 "행동 제안받기 / 내 고민 더 알아보기" 선택 대화 (기본 꺼짐).
# "true"로 정확히 설정했을 때만 켜진다. 2026-10-07 새 구조 개편 후에도 owner 확인 전까지는 켜지 말 것.
# THEORY_OFFER_ENABLED=
# 칩을 안 누르고 말을 이어가면 탐색으로 넘어갈지(기본 켜짐, "false"로 두면 평소 대화로 계속).
# THEORY_IMPLICIT_EXPLORE=true
# 이론 고르기에 쓰는 모델(없으면 CHAT_MODEL). 세션당 한 번 호출된다.
# THEORY_SELECT_MODEL=
# 이론 고르기 호출의 추론 수준(low/medium/high, 기본 low). "default"면 지정하지 않음.
# THEORY_SELECT_REASONING=low
