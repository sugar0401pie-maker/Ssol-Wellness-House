# saju.ssolwellnesshouse.com 환경 변수 — 값은 Vercel 프로젝트 Settings → Environment Variables에만 넣는다(이 파일에는 이름만).

# 사이트 주소(공유 링크·카카오 공유 그림 주소에 씀)
NEXT_PUBLIC_SITE_URL=https://saju.ssolwellnesshouse.com
# 쏘웰라 주소(작심삼일 챌린지·쏘웰라 3일 무료 버튼)
NEXT_PUBLIC_SOWELLA_URL=https://app.ssolwellnesshouse.com

# Supabase — 쏘웰라와 같은 프로젝트(쏘웰라가 saju_results.report->'challenge'를 읽음)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 결제창(API 개별 연동 키). 테스트: test_ck_… / test_sk_…, 운영: live_ck_… / live_sk_…
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 카카오톡 공유 — JavaScript 키(쏘웰라와 같은 이름). Kakao Developers → 플랫폼 → Web에 saju 도메인 등록 필요
NEXT_PUBLIC_KAKAO_JS_KEY=

# 개발용 가짜 결제를 운영에서 일부러 켤 때만 1(평소에는 넣지 않음)
# SAJU_FAKE_PAYMENT=
